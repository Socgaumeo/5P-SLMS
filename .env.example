# 5P-SLMS Environment Variables
# Copy this file to .env and fill in your values

# Application
DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# AI Provider (gemini, deepseek, or anthropic)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
GOOGLE_GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# JWT
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret
